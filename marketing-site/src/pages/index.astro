---
const features=[
 ["Mission-first control","Represent route, payload, timing, altitude, home position, and approval as a durable mission—not an ad hoc command stream."],
 ["Bounded commands","Every arm, launch, hold, return, land, or payload action carries a target, expiry, idempotency key, and operator context."],
 ["Airspace policy","Geofences, no-fly zones, altitude ceilings, weather constraints, and local permissions participate in preflight."],
 ["Fleet telemetry","Position, battery, link quality, health, and mission phase remain observable without giving telemetry channels command authority."],
 ["Human release gates","Automations can prepare missions and recommendations while high-consequence execution remains reviewable and cancellable."],
 ["Audit and replay","Commands, acknowledgements, policy decisions, and state transitions produce an evidence trail for incident analysis."],
];
const samples=[
 {id:"ts",label:"TypeScript API preview",file:"mission.ts",code:`const mission = await fetch(baseUrl + "/v1/missions", {
  method: "POST",
  headers: {
    authorization: "Bearer " + accessToken,
    "content-type": "application/json",
  },
  body: JSON.stringify({
    droneId: "drone-17",
    objective: "inspect north roof",
    route: waypoints,
    constraints: { maxAltitudeM: 80, returnBatteryPct: 28 },
  }),
}).then((response) => response.json());

console.log(mission.id, mission.preflight.state);`,note:"Illustrative mission API preview. The final public interface must define the production payload exactly."},
 {id:"rust",label:"Rust API preview",file:"command.rs",code:`let command = CommandRequest {
    drone_id: "drone-17".into(),
    mission_id: mission.id.clone(),
    kind: CommandKind::Hold,
    expires_at: now + Duration::seconds(15),
    idempotency_key: Uuid::new_v4().to_string(),
};

let receipt = client.issue_command(command).await?;
assert_eq!(receipt.authority, "operator-reviewed");`,note:"Illustrative typed command boundary: commands expire, deduplicate, and remain tied to mission authority."},
 {id:"curl",label:"curl preflight",file:"preflight.sh",code:`curl --fail-with-body \
  -X POST "$BASE_URL/v1/missions/$MISSION_ID/preflight" \
  -H "authorization: Bearer $ACCESS_TOKEN" \
  -H "content-type: application/json" \
  --data '{"weatherSnapshot":"wx_01J...","airspaceSnapshot":"as_01J..."}'

# Release only after policy and operator review return ready.`,note:"Preflight evaluates the mission against explicit weather, airspace, vehicle, and operator snapshots."},
 {id:"json",label:"Mission document",file:"mission.json",code:`{
  "droneId": "drone-17",
  "objective": "inspect north roof",
  "route": [
    {"lat": -12.0464, "lon": -77.0428, "altitudeM": 45},
    {"lat": -12.0458, "lon": -77.0419, "altitudeM": 55}
  ],
  "constraints": {
    "maxAltitudeM": 80,
    "returnBatteryPct": 28,
    "geofenceId": "site-north"
  },
  "release": {"state": "awaiting-operator"}
}`,note:"A durable mission document separates intent and constraints from transient telemetry and control links."},
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Mission, airspace, telemetry, and bounded command infrastructure for managed drone fleets."><meta name="theme-color" content="#0a1820"><title>Drone Manager — fleet control with boundaries</title></head><body>
<header><a class="brand" href="/"><b>DM</b><span>Drone Manager</span></a><nav><a href="#platform">Control plane</a><a href="#clients">API</a><a href="https://github.com/drone-mngr">GitHub ↗</a></nav></header><main>
<section class="hero"><div><p class="eyebrow">Fleet and airspace control · Safety-first</p><h1>Coordinate the fleet. <em>Bound every command.</em></h1><p class="lede">Drone Manager turns route intent into reviewable missions, airspace-aware preflight, expiring commands, observable telemetry, and replayable decisions for single vehicles or managed fleets.</p><div class="actions"><a class="primary" href="https://github.com/drone-mngr">Explore the platform ↗</a><a href="#clients">See the API preview</a></div><ul><li>Mission release gates</li><li>Airspace policy</li><li>Command audit</li></ul></div><div class="visual"><span class="grid"></span><div class="map"><i class="route r1"></i><i class="route r2"></i><b class="drone">◆</b></div><div class="core"><small>MISSION 0248</small><strong>preflight ready</strong><i>operator release required</i></div><div class="chip c1">FLEET<b>12 online</b></div><div class="chip c2">AIRSPACE<b>clear</b></div><div class="chip c3">BATTERY<b>86%</b></div><div class="chip c4">LINK<b>healthy</b></div></div></section>
<section class="metrics"><div><b>1</b><span>mission authority</span></div><div><b>4</b><span>preflight domains</span></div><div><b>0</b><span>unbounded commands</span></div><div><b>100%</b><span>audited transitions</span></div></section>
<section id="platform" class="platform"><p class="eyebrow">Control without ambiguity</p><h2>Telemetry observes. Missions authorize. Commands expire.</h2><p class="intro">The platform keeps mission intent, vehicle telemetry, policy evaluation, operator release, and command transport separate. That makes automation useful without letting a noisy channel or stale request silently become flight authority.</p><div class="features">{features.map(([t,b],i)=><article><small>{String(i+1).padStart(2,"0")}</small><h3>{t}</h3><p>{b}</p></article>)}</div></section>
<section id="clients" class="sdk" data-sdk><div><p class="eyebrow">API preview</p><h2>Design fleet integrations around durable missions and bounded commands.</h2><p class="intro">A public `drone-mngr-clients` package is not released yet. These examples communicate the intended safety boundary and must be reconciled with the final public interfaces before production use.</p><a class="source" href="https://github.com/drone-mngr">Follow the implementation ↗</a></div><div class="workbench"><div class="toolbar"><label><span>Example</span><select aria-label="Select client language" data-language>{samples.map((s,i)=><option value={s.id} selected={i===0}>{s.label}</option>)}</select></label><code data-file>{samples[0]?.file ?? "mission.ts"}</code><button data-copy type="button">Copy</button></div>{samples.map((s,i)=><article data-sample={s.id} data-name={s.file} hidden={i!==0}><pre tabindex="0"><code>{s.code}</code></pre><p>{s.note}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">Automation should increase control</p><h2>Make every mission understandable before it leaves the ground.</h2><a href="https://github.com/drone-mngr">Open the organization ↗</a></section></main><footer><span>© 2026 Drone Manager</span><a href="https://github.com/drone-mngr">Source</a></footer>
<script is:inline>document.querySelectorAll('[data-sdk]').forEach((r)=>{const s=r.querySelector('[data-language]'),f=r.querySelector('[data-file]'),c=r.querySelector('[data-copy]'),p=[...r.querySelectorAll('[data-sample]')];const show=(id)=>p.forEach((x)=>{const a=x.dataset.sample===id;x.hidden=!a;if(a)f.textContent=x.dataset.name||''});s?.addEventListener('change',(e)=>show(e.target.value));c?.addEventListener('click',async()=>{const a=p.find((x)=>!x.hidden),t=a?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(t);c.textContent='Copied'}catch{a?.querySelector('pre')?.focus();c.textContent='Select code'}setTimeout(()=>c.textContent='Copy',1200)})});</script>
<style>:root{--accent:#0f766e;--hot:#84cc16;--ink:#0a1820;--muted:#64747a;--paper:#f4faf8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,#ecfeff,var(--paper) 36rem);color:var(--ink);font:16px/1.6 Inter,system-ui,sans-serif}a{color:inherit}header,main,footer{width:min(1180px,calc(100% - 2rem));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 0}.brand{display:flex;gap:.6rem;align-items:center;font-weight:900;text-decoration:none}.brand b{display:grid;width:2.35rem;aspect-ratio:1;place-items:center;border-radius:.75rem;background:var(--ink);color:white;font-size:.7rem}nav{display:flex;gap:1.2rem;font-size:.85rem;font-weight:800}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(2rem,7vw,7rem);align-items:center;min-height:720px;padding:5rem 0}.eyebrow{margin:0;color:var(--accent);font:800 .7rem/1 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}h1{max-width:12ch;margin:.8rem 0 1.25rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;letter-spacing:-.075em}h1 em{background:linear-gradient(120deg,var(--accent),var(--hot));background-clip:text;color:transparent;font-style:normal}.lede,.intro{max-width:47rem;color:var(--muted);font-size:1.08rem}.actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:2rem 0}.actions a,.closing a{padding:.75rem 1rem;border:1px solid #0f172a1b;border-radius:.75rem;font-weight:850;text-decoration:none}.primary{background:var(--ink);color:white}.hero ul{display:flex;gap:1rem;flex-wrap:wrap;margin:0;padding:0;color:var(--muted);font-size:.8rem;list-style:none}.hero li:before{content:'◆';margin-right:.4rem;color:var(--accent)}.visual{position:relative;min-height:32rem;overflow:hidden;border-radius:2rem;background:radial-gradient(circle at 50% 48%,#14b8a645,transparent 40%),linear-gradient(145deg,#07171b,#153631);box-shadow:0 35px 90px #134e4a40}.grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);background-size:2.4rem 2.4rem}.map{position:absolute;inset:13%;border:1px solid #ffffff15;border-radius:50%;background:radial-gradient(circle,#ffffff08 1px,transparent 1px);background-size:1.2rem 1.2rem}.route{position:absolute;height:2px;background:#a3e635;transform-origin:left}.r1{left:18%;top:65%;width:44%;transform:rotate(-27deg)}.r2{left:57%;top:46%;width:30%;transform:rotate(35deg)}.drone{position:absolute;left:53%;top:39%;color:white;font-size:1.6rem}.core,.chip{position:absolute;z-index:2;display:grid;padding:.9rem;border:1px solid #ffffff25;border-radius:1rem;background:#0b2825df;color:#5eead4;backdrop-filter:blur(12px);font:700 .64rem/1.5 ui-monospace,monospace}.core{top:56%;left:50%;width:14rem;padding:1.2rem;transform:translate(-50%,-50%)}.core strong,.chip b{color:white}.core strong{font-size:1.28rem}.core i{font-style:normal}.c1{top:8%;left:7%}.c2{top:8%;right:7%}.c3{bottom:9%;left:7%}.c4{right:7%;bottom:9%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;border:1px solid #134e4a18;border-radius:1.15rem;background:#ffffffc9}.metrics div{display:grid;padding:1.2rem}.metrics div+div{border-left:1px solid #134e4a18}.metrics b{font-size:1.3rem}.metrics span{color:var(--muted);font-size:.76rem}.platform{padding:8rem 0}.platform h2,.sdk h2,.closing h2{max-width:15ch;margin:.55rem 0 1rem;font-size:clamp(2.6rem,6vw,5rem);line-height:.94;letter-spacing:-.06em}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.features article{min-height:14rem;padding:1.3rem;border:1px solid #134e4a14;border-radius:1.1rem;background:#ffffffc5}.features small{color:var(--accent);font:800 .68rem/1 ui-monospace,monospace}.features h3{margin:2.1rem 0 .55rem}.features p{color:var(--muted)}.sdk{display:grid;grid-template-columns:minmax(0,.78fr) minmax(31rem,1.22fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:3rem 0 9rem}.source{display:inline-block;margin-top:1rem;color:var(--accent);font-weight:850;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.25rem;background:#07171b;color:#d1fae5;box-shadow:0 32px 90px #134e4a40}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.85rem 1rem;border-bottom:1px solid #ffffff18;background:#0b2825}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#5eead4;font:700 .6rem/1 ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.58rem;background:#133c37;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#5eead4;font-size:.75rem}.workbench pre{overflow:auto;min-height:23rem;max-height:31rem;margin:0;padding:1.2rem;font:500 .82rem/1.7 ui-monospace,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.2rem 1rem;border-top:1px solid #ffffff15;color:#5eead4;font-size:.78rem}.closing{margin-bottom:2rem;padding:clamp(2rem,7vw,6rem);border-radius:1.8rem;background:linear-gradient(125deg,var(--accent),#65a30d);color:white}.closing .eyebrow{color:#ffffffc7}.closing a{display:inline-block;margin-top:1rem;background:white;color:var(--ink)}footer{display:flex;gap:1rem;padding:1.5rem 0 3rem;color:var(--muted);font-size:.78rem}footer span{margin-right:auto}footer a{text-decoration:none}@media(max-width:900px){.hero,.sdk{grid-template-columns:1fr}.features{grid-template-columns:1fr 1fr}}@media(max-width:650px){nav a:not(:last-child){display:none}.visual{min-height:26rem}.metrics{grid-template-columns:1fr 1fr}.features{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}</style></body></html>
